# Multi-stage Dockerfile for wrss
# Generated by audit-bot following the airesearch pattern

# =============================================================================
# Stage 1: System dependencies (if needed)
# =============================================================================
FROM python:3.12-slim-bookworm AS base

# Install system packages needed for building Python deps and runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# =============================================================================
# Stage 2: Python dependencies
# =============================================================================
FROM base AS python-deps

ENV PIP_ROOT_USER_ACTION=ignore
ENV PIP_NO_CACHE_DIR=1
WORKDIR /app

# Copy dependency files first for better cache utilization
COPY requirements.txt ./
RUN pip install --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt


# =============================================================================
# Stage 3: Final runtime image
# =============================================================================
FROM python-deps AS runtime

# Runtime configuration
ARG HOST=0.0.0.0
ENV HOST=${HOST}
ARG PORT=[REDACTED:loopback-port]
ENV PORT=${PORT}
EXPOSE ${PORT}

# Uvicorn/Gunicorn/Waitress parameters
ARG WORKERS=4
ENV WORKERS=${WORKERS}

# Create non-root user for security
RUN useradd -ms /bin/bash appuser \
    && chown -R appuser:appuser /app
USER appuser
WORKDIR /app

# Copy application code with proper ownership
COPY --chown=appuser:appuser . .

# Run the application
CMD waitress-serve --host=0.0.0.0 --port=${PORT} wrss:app